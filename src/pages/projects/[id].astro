---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const date = project.data.date.toISOString().slice(0, 10);
---
<Base
  title={`${project.data.title} · ${site.name}`}
  description={project.data.title}
  path={`/projects/${project.id}/`}
  type="article"
  jsonLd={{ "@context": "https://schema.org", "@type": "BlogPosting", headline: project.data.title, datePublished: date }}
>
  <article>
    <h1>{project.data.title}</h1>
    <p class="meta">{date}</p>
    {project.data.link && <p><a href={project.data.link} target="_blank" rel="noopener">Project page</a></p>}
    <Content />
  </article>
</Base>
